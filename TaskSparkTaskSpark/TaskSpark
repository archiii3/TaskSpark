#!/usr/bin/env python3
"""
Clario
A minimal CLI utility for organizing files and generating directory insights.

Usage:
    python clario.py .
    python clario.py ./downloads --organize
    python clario.py . --summary
"""

import argparse
import os
import shutil
from collections import Counter
from pathlib import Path


FILE_GROUPS = {
    "Images": {".jpg", ".jpeg", ".png", ".gif", ".svg", ".webp"},
    "Videos": {".mp4", ".mkv", ".mov", ".avi", ".webm"},
    "Documents": {".pdf", ".doc", ".docx", ".txt", ".md", ".rtf"},
    "Spreadsheets": {".xls", ".xlsx", ".csv"},
    "Archives": {".zip", ".rar", ".7z", ".tar", ".gz"},
    "Audio": {".mp3", ".wav", ".flac", ".aac"},
    "Code": {".py", ".js", ".ts", ".html", ".css", ".java", ".cpp"},
}


def get_category(extension: str) -> str:
    """Return a category for a file extension."""
    extension = extension.lower()

    for category, extensions in FILE_GROUPS.items():
        if extension in extensions:
            return category

    return "Other"


def scan_directory(directory: Path) -> list[Path]:
    """Return files in the target directory, excluding hidden files."""
    return [
        item
        for item in directory.iterdir()
        if item.is_file() and not item.name.startswith(".")
    ]


def show_summary(files: list[Path]) -> None:
    """Display useful statistics about directory contents."""
    if not files:
        print("No files found.")
        return

    categories = Counter(get_category(file.suffix) for file in files)
    total_size = sum(file.stat().st_size for file in files)

    print("\nClario Summary")
    print("-" * 30)
    print(f"Total files: {len(files)}")
    print(f"Total size:  {total_size / 1024 / 1024:.2f} MB")
    print("\nFile types:")

    for category, count in categories.most_common():
        print(f"  {category:<15} {count}")


def organize_files(directory: Path, files: list[Path]) -> None:
    """Move files into categorized folders."""
    moved = 0

    for file in files:
        category = get_category(file.suffix)
        target_dir = directory / category
        target_dir.mkdir(exist_ok=True)

        destination = target_dir / file.name

        # Prevent overwriting existing files
        if destination.exists():
            stem = destination.stem
            suffix = destination.suffix
            counter = 1

            while destination.exists():
                destination = target_dir / f"{stem}_{counter}{suffix}"
                counter += 1

        shutil.move(str(file), str(destination))
        moved += 1

    print(f"\nOrganized {moved} files successfully.")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Clario - A minimal file organization utility."
    )

    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="Directory to analyze (default: current directory)",
    )

    parser.add_argument(
        "--organize",
        action="store_true",
        help="Organize files into categorized folders",
    )

    parser.add_argument(
        "--summary",
        action="store_true",
        help="Show directory statistics",
    )

    args = parser.parse_args()
    directory = Path(args.directory).expanduser().resolve()

    if not directory.exists() or not directory.is_dir():
        print("Error: Invalid directory.")
        return

    files = scan_directory(directory)

    if args.organize:
        organize_files(directory, files)
    else:
        show_summary(files)


if __name__ == "__main__":
    main()
